<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.casehub</groupId>
        <artifactId>casehub-parent</artifactId>
        <version>0.4-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.casehub.langchain4j</groupId>
    <artifactId>casehub-langchain4j-parent</artifactId>
    <version>0.4-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CaseHub LangChain4j — Enterprise Enrichment</name>
    <description>Additive enterprise concerns for LangChain4j: audit, tenancy, governance, hybrid search.</description>

    <modules>
        <module>audit-core</module>
        <module>audit</module>
        <module>audit-spring</module>
        <module>tenancy-core</module>
        <module>tenancy</module>
        <module>tenancy-spring</module>
        <module>governance-core</module>
        <module>governance</module>
        <module>governance-spring</module>
        <module>hybrid-search-core</module>
        <module>hybrid-search</module>
        <module>hybrid-search-spring</module>
        <module>agents-core</module>
        <module>agents</module>
        <module>agents-spring</module>
        <module>bom</module>
        <module>examples</module>
    </modules>

    <properties>
        <version.dev.langchain4j.agentic>1.16.2-beta26</version.dev.langchain4j.agentic>
        <version.io.casehub>0.4-SNAPSHOT</version.io.casehub>
        <version.io.casehub.ledger>0.4-SNAPSHOT</version.io.casehub.ledger>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4j agentic (not in parent BOM) -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-agentic</artifactId>
                <version>${version.dev.langchain4j.agentic}</version>
            </dependency>

            <!-- CaseHub modules -->
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-platform-api</artifactId>
                <version>${version.io.casehub}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-platform-agent-api</artifactId>
                <version>${version.io.casehub}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-ledger-api</artifactId>
                <version>${version.io.casehub.ledger}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-neocortex-rag-api</artifactId>
                <version>${version.io.casehub}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub</groupId>
                <artifactId>casehub-engine-api</artifactId>
                <version>${version.io.casehub}</version>
            </dependency>

            <!-- This project's own modules -->
            <dependency>
                <groupId>io.casehub.langchain4j</groupId>
                <artifactId>casehub-langchain4j-audit-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub.langchain4j</groupId>
                <artifactId>casehub-langchain4j-tenancy-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub.langchain4j</groupId>
                <artifactId>casehub-langchain4j-governance-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub.langchain4j</groupId>
                <artifactId>casehub-langchain4j-hybrid-search-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.casehub.langchain4j</groupId>
                <artifactId>casehub-langchain4j-agents-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-autoconfigure</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

  
  <repositories>
    <repository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/*</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/casehubio/casehub-langchain4j</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <url>https://maven.pkg.github.com/casehubio/casehub-langchain4j</url>
        </snapshotRepository>
    </distributionManagement>

    <scm>
        <connection>scm:git:https://github.com/casehubio/casehub-langchain4j.git</connection>
        <developerConnection>scm:git:https://github.com/casehubio/casehub-langchain4j.git</developerConnection>
        <url>https://github.com/casehubio/casehub-langchain4j</url>
    </scm>

</project>
